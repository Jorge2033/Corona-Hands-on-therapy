# Copia este archivo como .env.local y rellena los valores reales.
# .env.local NUNCA se sube a GitHub (está en .gitignore).
#
# Sin estas variables el sitio funciona en local, pero los formularios
# responden "no está configurado" al intentar enviar el correo.

# Credenciales de la Gmail API (mismas que en el VPS; ver .env.production.example
# para el paso a paso de cómo obtenerlas en Google Cloud + OAuth Playground)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Cuenta de Gmail que ENVÍA el correo (la de la clínica)
MAIL_FROM_EMAIL=coronahealthcare90@gmail.com

# A dónde llegan los correos de contacto (puede ser la misma cuenta)
CONTACT_TO_EMAIL=coronahealthcare90@gmail.com

# Clave de cifrado de la base de datos local (AES-256). Genera una con:
#   openssl rand -hex 32
DATA_ENCRYPTION_KEY=
