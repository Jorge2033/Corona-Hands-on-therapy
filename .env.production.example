# Copia este archivo como .env.production en el VPS y llena los valores reales.

# --- Correo ---
# El VPS (DigitalOcean) bloquea los puertos SMTP salientes (25/465/587), así que
# el envío va por la API de Gmail sobre HTTPS. Ver src/lib/mailer.ts.
#
# Cómo obtener las credenciales (una sola vez, con la cuenta de Gmail de la clínica):
#   1. console.cloud.google.com -> crear proyecto -> habilitar "Gmail API"
#   2. OAuth consent screen -> publicar la app (si queda en Testing el token
#      caduca a los 7 días)
#   3. Credentials -> OAuth client ID (Web application) con redirect URI
#      https://developers.google.com/oauthplayground
#   4. developers.google.com/oauthplayground -> usar las credenciales propias,
#      scope https://www.googleapis.com/auth/gmail.send -> obtener refresh token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Remitente (la misma cuenta que autorizó el refresh token)
MAIL_FROM_EMAIL=
# Buzón que recibe los formularios
CONTACT_TO_EMAIL=

# --- Alternativa: relay SMTP ---
# Solo si en vez de la Gmail API se usa un relay SMTP en un puerto abierto
# (p. ej. 2525), o si DigitalOcean desbloquea el SMTP saliente. Si estas
# variables están y las de Gmail no, el mailer usa esta vía.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# --- Base de datos ---
# Clave de cifrado de la base de datos (AES-256). Genera una con:
#   openssl rand -hex 32
# GUÁRDALA en un lugar seguro: sin ella los datos guardados no se pueden leer.
DATA_ENCRYPTION_KEY=
